# 依赖
node_modules/
.npm-cache/

# 数据库数据目录（5 个 PG 实例，约 1.75 GB）
# 注意：必须写前导斜杠，否则会误伤 src/seed/data/ 这类源码目录
/data/

# 运行时产物
/storage/
/snapshots/
/backups/
/web/generated/

# 注意：/web/vendor/ 不忽略——仓库内保留一份产物，克隆即可运行；
# 升级 maplibre 后用 npm run vendor 刷新。

# 日志与临时文件
*.log
*.out
*.err
.smoke*
.tmp/

# 截图（本地验收产物，不随仓库分发）
/shots/

# 系统/编辑器
.DS_Store
Thumbs.db
.vscode/
.idea/
